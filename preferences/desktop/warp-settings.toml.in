[privacy]
telemetry_enabled = false
crash_reporting_enabled = false
[appearance.text]
font_size = 18.0
line_height_ratio = 1.2000000476837158
font_name = "Hack"
[appearance.themes]
theme = { custom = { name = "Classic Vivid", path = "__DOTFILES_HOME__/.warp/themes/standard/classic_vivid.yaml" } }
[appearance.vertical_tabs]
enabled = true
[appearance.window]
zoom_level = 110
[terminal.input]
input_box_type_setting = "universal"
alias_expansion_enabled = true
completions_open_while_typing = false
[code.editor]
open_file_editor = { external_editor = "web_storm" }
[notifications]
toast_duration_secs = 8
