{
  "name": "Work",
  "settings": "{\n  \"[javascript]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"[typescriptreact]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"editor.accessibilitySupport\": \"off\",\n  \"files.autoSave\": \"afterDelay\",\n  \"gitlens.codeLens.enabled\": false,\n  \"gitlens.currentLine.enabled\": false,\n  \"gitlens.hovers.currentLine.over\": \"line\",\n  \"gitlens.rebaseEditor.ordering\": \"asc\",\n  \"terminal.integrated.env.osx\": {\n    \"FIG_NEW_SESSION\": \"1\"\n  },\n  \"workbench.editorAssociations\": {\n    \"git-rebase-todo\": \"default\"\n  },\n  \"workbench.iconTheme\": \"vscode-icons\",\n  \"workbench.startupEditor\": \"none\",\n  \"[typescript]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"workbench.colorTheme\": \"Webstorm Darcula\",\n  \"i18n-ally.extract.autoDetect\": true,\n  \"editor.fontSize\": 16,\n  \"i18n-ally.extract.keyPrefix\": \"{fileNameWithoutExt}\",\n  \"i18n-ally.preferredDelimiter\": \"_\",\n  \"i18n-ally.sortKeys\": true,\n  \"vsicons.dontShowNewVersionMessage\": true,\n  \"gitlens.showWelcomeOnInstall\": false,\n  \"gitlens.codeLens.authors.enabled\": false,\n  \"gitlens.hovers.enabled\": false,\n  \"tailwindCSS.emmetCompletions\": true,\n  \"editsHistory.loopAround\": true,\n  \"editor.lineHeight\": 1.6,\n  \"editor.wordWrap\": \"on\",\n  \"console-ninja.featureSet\": \"Community\",\n  \"[jsonc]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"editor.fontFamily\": \"'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace\",\n  \"editor.bracketPairColorization.enabled\": false,\n  \"editor.smartSelect.selectLeadingAndTrailingWhitespace\": false\n}\n",
  "keybindings": "[\n  {\n    \"key\": \"alt+cmd+z\",\n    \"command\": \"git.revertSelectedRanges\",\n    \"when\": \"isInDiffEditor\"\n  },\n  {\n    \"key\": \"cmd+k cmd+r\",\n    \"command\": \"-git.revertSelectedRanges\",\n    \"when\": \"isInDiffEditor\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"-search.searchEditor.action.deleteFileResults\",\n    \"when\": \"inSearchEditor\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"editsHistory.moveCursorToPreviousEdit\"\n  },\n  {\n    \"key\": \"cmd+j\",\n    \"command\": \"-editsHistory.moveCursorToPreviousEdit\"\n  },\n  {\n    \"key\": \"shift+cmd+j\",\n    \"command\": \"-editsHistory.moveCursorToPreviouslyEditedFile\"\n  },\n  {\n    \"key\": \"shift+cmd+k\",\n    \"command\": \"-editsHistory.moveCursorToNextEditedFile\"\n  },\n  {\n    \"key\": \"shift+cmd+u\",\n    \"command\": \"-editsHistory.moveCursorToPreviousEditInSameFile\"\n  },\n  {\n    \"key\": \"cmd+u\",\n    \"command\": \"-editsHistory.createEditAtCursor\"\n  },\n  {\n    \"key\": \"cmd+i\",\n    \"command\": \"-editsHistory.removeEditsFromLine\"\n  },\n  {\n    \"key\": \"shift+cmd+i\",\n    \"command\": \"-editsHistory.moveCursorToNextEditInSameFile\"\n  },\n  {\n    \"key\": \"ctrl+shift+cmd+backspace\",\n    \"command\": \"editsHistory.moveCursorToNextEdit\"\n  },\n  {\n    \"key\": \"cmd+k\",\n    \"command\": \"-editsHistory.moveCursorToNextEdit\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"gotoLastEdit.goBack\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"cmd+-\",\n    \"command\": \"-gotoLastEdit.goBack\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"ctrl+shift+cmd+backspace\",\n    \"command\": \"gotoLastEdit.goForward\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"cmd+=\",\n    \"command\": \"-gotoLastEdit.goForward\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"-workbench.action.navigateToLastEditLocation\"\n  },\n  {\n    \"key\": \"alt+cmd+left\",\n    \"command\": \"-workbench.action.previousEditor\"\n  },\n  {\n    \"key\": \"alt+cmd+right\",\n    \"command\": \"-workbench.action.nextEditor\"\n  },\n  {\n    \"key\": \"cmd+e\",\n    \"command\": \"-actions.findWithSelection\"\n  },\n  {\n    \"key\": \"shift+alt+o\",\n    \"command\": \"-editor.action.organizeImports\",\n    \"when\": \"editorTextFocus && !editorReadonly && supportedCodeAction =~ /(\\\\s|^)source\\\\.organizeImports\\\\b/\"\n  },\n  {\n    \"key\": \"cmd+e\",\n    \"command\": \"workbench.action.quickOpen\"\n  },\n  {\n    \"key\": \"cmd+up\",\n    \"command\": \"block-travel.jumpUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"alt+up\",\n    \"command\": \"-block-travel.jumpUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"cmd+down\",\n    \"command\": \"block-travel.jumpDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"alt+down\",\n    \"command\": \"-block-travel.jumpDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+cmd+down\",\n    \"command\": \"block-travel.selectDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+alt+down\",\n    \"command\": \"-block-travel.selectDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+cmd+up\",\n    \"command\": \"block-travel.selectUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+alt+up\",\n    \"command\": \"-block-travel.selectUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"alt+cmd+j\",\n    \"command\": \"-liveshare.join\",\n    \"when\": \"liveshare:state != 'Joined' && liveshare:state != 'Shared'\"\n  },\n  {\n    \"key\": \"alt+cmd+j\",\n    \"command\": \"editor.action.surroundWithSnippet\"\n  },\n  {\n    \"key\": \"cmd+j\",\n    \"command\": \"editor.action.insertSnippet\"\n  },\n  {\n    \"key\": \"cmd+j\",\n    \"command\": \"-workbench.action.togglePanel\"\n  }\n]\n",
  "extensions": "[{\"identifier\": {\"id\": \"formulahendry.auto-rename-tag\"}, \"displayName\": \"formulahendry.auto-rename-tag\"}, {\"identifier\": {\"id\": \"sonalsithara.intellij-one-dark\"}, \"displayName\": \"sonalsithara.intellij-one-dark\"}, {\"identifier\": {\"id\": \"jeremyljackson.vs-docblock\"}, \"displayName\": \"jeremyljackson.vs-docblock\"}, {\"identifier\": {\"id\": \"stephenykk.i18n-easy\"}, \"displayName\": \"stephenykk.i18n-easy\"}, {\"identifier\": {\"id\": \"antfu.smart-clicks\"}, \"displayName\": \"antfu.smart-clicks\"}, {\"identifier\": {\"id\": \"lokalise.i18n-ally\"}, \"displayName\": \"lokalise.i18n-ally\"}, {\"identifier\": {\"id\": \"imekachi.webstorm-darcula\"}, \"displayName\": \"imekachi.webstorm-darcula\"}, {\"identifier\": {\"id\": \"rebornix.project-snippets\"}, \"displayName\": \"rebornix.project-snippets\"}, {\"identifier\": {\"id\": \"be5invis.toml\"}, \"displayName\": \"be5invis.toml\"}, {\"identifier\": {\"id\": \"simonsiefke.svg-preview\"}, \"displayName\": \"simonsiefke.svg-preview\"}, {\"identifier\": {\"id\": \"mikestead.dotenv\"}, \"displayName\": \"mikestead.dotenv\"}, {\"identifier\": {\"id\": \"usernamehw.errorlens\"}, \"displayName\": \"usernamehw.errorlens\"}, {\"identifier\": {\"id\": \"zixuanchen.vitest-explorer\"}, \"displayName\": \"zixuanchen.vitest-explorer\"}, {\"identifier\": {\"id\": \"yzhang.markdown-all-in-one\"}, \"displayName\": \"yzhang.markdown-all-in-one\"}, {\"identifier\": {\"id\": \"aaron-bond.better-comments\"}, \"displayName\": \"aaron-bond.better-comments\"}, {\"identifier\": {\"id\": \"tedisagolli.hex-to-tailwind\"}, \"displayName\": \"tedisagolli.hex-to-tailwind\"}, {\"identifier\": {\"id\": \"richie5um2.vscode-sort-json\"}, \"displayName\": \"richie5um2.vscode-sort-json\"}, {\"identifier\": {\"id\": \"wmaurer.change-case\"}, \"displayName\": \"wmaurer.change-case\"}, {\"identifier\": {\"id\": \"christian-kohler.npm-intellisense\"}, \"displayName\": \"christian-kohler.npm-intellisense\"}, {\"identifier\": {\"id\": \"plrenaudin.gotolastedit\"}, \"displayName\": \"plrenaudin.gotolastedit\"}, {\"identifier\": {\"id\": \"nicoespeon.abracadabra\"}, \"displayName\": \"nicoespeon.abracadabra\"}, {\"identifier\": {\"id\": \"liamhammett.inline-parameters\"}, \"displayName\": \"liamhammett.inline-parameters\"}, {\"identifier\": {\"id\": \"bierner.markdown-preview-github-styles\"}, \"displayName\": \"bierner.markdown-preview-github-styles\"}, {\"identifier\": {\"id\": \"codespaces-contrib.codeswing\"}, \"displayName\": \"codespaces-contrib.codeswing\"}, {\"identifier\": {\"id\": \"sashaweiss.block-travel\"}, \"displayName\": \"sashaweiss.block-travel\"}, {\"identifier\": {\"id\": \"sburg.vscode-javascript-booster\"}, \"displayName\": \"sburg.vscode-javascript-booster\"}, {\"identifier\": {\"id\": \"sleistner.vscode-fileutils\"}, \"displayName\": \"sleistner.vscode-fileutils\"}, {\"identifier\": {\"id\": \"igorsbitnev.error-gutters\"}, \"displayName\": \"igorsbitnev.error-gutters\"}, {\"identifier\": {\"id\": \"klog.smart-react-component-extractor\"}, \"displayName\": \"klog.smart-react-component-extractor\"}, {\"identifier\": {\"id\": \"bierner.comment-tagged-templates\"}, \"displayName\": \"bierner.comment-tagged-templates\"}, {\"identifier\": {\"id\": \"esbenp.prettier-vscode\"}, \"displayName\": \"esbenp.prettier-vscode\"}, {\"identifier\": {\"id\": \"ms-vsliveshare.vsliveshare\"}, \"displayName\": \"ms-vsliveshare.vsliveshare\"}, {\"identifier\": {\"id\": \"vscode-icons-team.vscode-icons\"}, \"displayName\": \"vscode-icons-team.vscode-icons\"}, {\"identifier\": {\"id\": \"dbaeumer.vscode-eslint\"}, \"displayName\": \"dbaeumer.vscode-eslint\"}, {\"identifier\": {\"id\": \"bradlc.vscode-tailwindcss\"}, \"displayName\": \"bradlc.vscode-tailwindcss\"}, {\"identifier\": {\"id\": \"davidanson.vscode-markdownlint\"}, \"displayName\": \"davidanson.vscode-markdownlint\"}, {\"identifier\": {\"id\": \"zhuangtongfa.material-theme\"}, \"displayName\": \"zhuangtongfa.material-theme\"}, {\"identifier\": {\"id\": \"wallabyjs.console-ninja\"}, \"displayName\": \"wallabyjs.console-ninja\"}, {\"identifier\": {\"id\": \"foam.foam-vscode\"}, \"displayName\": \"foam.foam-vscode\"}, {\"identifier\": {\"id\": \"github.vscode-pull-request-github\"}, \"displayName\": \"github.vscode-pull-request-github\"}, {\"identifier\": {\"id\": \"eamodio.gitlens\"}, \"displayName\": \"eamodio.gitlens\"}, {\"identifier\": {\"id\": \"timonwong.shellcheck\"}, \"displayName\": \"timonwong.shellcheck\"}, {\"identifier\": {\"id\": \"chakrounanas.turbo-console-log\"}, \"displayName\": \"chakrounanas.turbo-console-log\"}, {\"identifier\": {\"id\": \"k--kato.intellij-idea-keybindings\"}, \"displayName\": \"k--kato.intellij-idea-keybindings\"}]",
  "snippets": "{\"snippets\": {\"typescriptreact.json\": \"{\\n  // Place your snippets for typescriptreact here. Each snippet is defined under a snippet name and has a prefix, body and\\n  // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the\\n  // same ids are connected.\\n  // Example:\\n  \\\"Print to console\\\": {\\n    \\\"prefix\\\": \\\"log\\\",\\n    \\\"body\\\": [\\\"console.log(\\\\\\\"$1\\\\\\\");\\\", \\\"$2\\\"],\\n    \\\"description\\\": \\\"Log output to console\\\"\\n  },\\n  \\\"Const destructuring\\\": {\\n    \\\"prefix\\\": \\\"co\\\",\\n    \\\"body\\\": [\\\"const { $2 } = ${1:props};\\\"],\\n    \\\"description\\\": \\\"Const destructuring\\\"\\n  },\\n  \\\"Import icon\\\": {\\n    \\\"prefix\\\": \\\"ic\\\",\\n    \\\"body\\\": [\\\"import { ReactComponent as $2 } from \\\\\\\"@/assets/icons/$1\\\\\\\";\\\"],\\n    \\\"description\\\": \\\"Import Icon\\\"\\n  },\\n  \\\"Add Translation\\\": {\\n    \\\"prefix\\\": \\\"tt\\\",\\n    \\\"body\\\": [\\\"const { t } = useTranslation();\\\"],\\n    \\\"description\\\": \\\"Add Translation via useTranslation\\\"\\n  }\\n}\\n\"}}"
}
