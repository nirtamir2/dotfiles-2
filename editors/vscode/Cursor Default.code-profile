{
  "name": "Cursor Default",
  "settings": "{\n  \"[javascript]\": {\n    \"editor.defaultFormatter\": \"vscode.typescript-language-features\"\n  },\n  \"[typescriptreact]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"[typescript]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"[css]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"[jsonc]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"eslint.workingDirectories\": [\n    {\n      \"mode\": \"auto\"\n    }\n  ],\n  \"editor.accessibilitySupport\": \"off\",\n  \"files.autoSave\": \"afterDelay\",\n  \"gitlens.codeLens.enabled\": false,\n  \"gitlens.currentLine.enabled\": false,\n  \"gitlens.hovers.currentLine.over\": \"line\",\n  \"gitlens.rebaseEditor.ordering\": \"asc\",\n  \"terminal.integrated.env.osx\": {\n    \"FIG_NEW_SESSION\": \"1\"\n  },\n  \"workbench.editorAssociations\": {\n    \"git-rebase-todo\": \"default\",\n    \"*.svg\": \"default\"\n  },\n  \"workbench.iconTheme\": \"vscode-icons\",\n  \"workbench.colorTheme\": \"Webstorm Darcula\",\n  \"i18n-ally.extract.autoDetect\": true,\n  \"editor.fontSize\": 16,\n  \"i18n-ally.preferredDelimiter\": \"_\",\n  \"i18n-ally.sortKeys\": true,\n  \"vsicons.dontShowNewVersionMessage\": true,\n  \"gitlens.codeLens.authors.enabled\": false,\n  \"gitlens.hovers.enabled\": false,\n  \"tailwindCSS.emmetCompletions\": true,\n  \"editor.lineHeight\": 1.6,\n  \"editor.wordWrap\": \"on\",\n  \"console-ninja.featureSet\": \"Community\",\n  \"editor.fontFamily\": \"'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace\",\n  \"editor.bracketPairColorization.enabled\": false,\n  \"editor.smartSelect.selectLeadingAndTrailingWhitespace\": false,\n  \"editor.smartSelect.selectSubwords\": false,\n  \"terminal.integrated.fontSize\": 16,\n  \"[vue]\": {\n    \"editor.defaultFormatter\": \"Vue.volar\"\n  },\n  \"[markdown]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"[astro]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"[json]\": {\n    \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"\n  },\n  \"gitFileExplorer.gitCommand\": \"git diff --name-only -z\",\n  \"gitlens.views.commits.files.layout\": \"list\",\n  \"workbench.editor.closeOnFileDelete\": true,\n  \"workbench.editor.highlightModifiedTabs\": true,\n  \"workbench.editor.limit.enabled\": true,\n  \"workbench.editor.limit.perEditorGroup\": true,\n  \"workbench.editor.limit.value\": 5,\n  \"search.exclude\": {\n    \"**/.cache\": true,\n    \"**/.expo\": true,\n    \"**/.git\": true,\n    \"**/.github\": false,\n    \"**/.nuxt\": true,\n    \"**/.output\": true,\n    \"**/.pnpm\": true,\n    \"**/.vscode\": true,\n    \"**/.yarn\": true,\n    \"**/*.snap\": true,\n    \"**/bower_components\": true,\n    \"**/CHANGELOG*\": true,\n    \"**/dist/**\": true,\n    \"**/LICENSE*\": true,\n    \"**/logs\": true,\n    \"**/node_modules\": true,\n    \"**/out/**\": true,\n    \"**/package-lock.json\": true,\n    \"**/pnpm-lock.yaml\": true,\n    \"**/temp\": true,\n    \"**/yarn.lock\": true\n  },\n  \"explorer.confirmDelete\": false,\n  \"explorer.confirmDragAndDrop\": false,\n  \"git.enableSmartCommit\": true,\n  \"git.confirmSync\": false,\n  \"git.allowNoVerifyCommit\": true,\n  \"git.confirmNoVerifyCommit\": false,\n  \"diffEditor.renderSideBySide\": true,\n  \"i18n-ally.extract.keyPrefix\": \"{fileNameWithoutExt}\",\n  \"files.watcherExclude\": {\n    \"**/node_modules/**\": true\n  },\n  \"typescript.tsserver.maxTsServerMemory\": 12288,\n  \"editor.defaultFormatter\": \"oxc.oxc-vscode\",\n  \"workbench.editor.customLabels.patterns\": {\n    \"**/app/**/page.tsx\": \"${dirname} - page.tsx\",\n    \"**/app/**/layout.tsx\": \"${dirname} - layout.tsx\",\n    \"**/app/**/loading.tsx\": \"${dirname} - loading.tsx\",\n    \"**/app/**/error.tsx\": \"${dirname} - error.tsx\",\n    \"**/index.*\": \"${dirname}/${filename}.${extname}\"\n  },\n  \"workbench.editor.enablePreview\": false,\n  \"files.simpleDialog.enable\": true,\n  \"git.blame.editorDecoration.enabled\": false,\n  \"[snippets]\": {\n    \"editor.defaultFormatter\": \"vscode.json-language-features\"\n  },\n  \"diffEditor.experimental.showMoves\": true,\n  \"git.closeDiffOnOperation\": true,\n  \"editor.linkedEditing\": true,\n  \"gitTreeCompare.diffMode\": \"full\",\n  \"[prisma]\": {\n    \"editor.defaultFormatter\": \"Prisma.prisma\"\n  },\n  \"mcpServers\": {},\n  \"merge-conflict.autoNavigateNextConflict.enabled\": true,\n  \"files.associations\": {\n    \"*.svg\": \"html\"\n  },\n  \"catalogLens.enabled\": true,\n  \"github.copilot.enable\": {\n    \"*\": true,\n    \"plaintext\": false,\n    \"markdown\": true,\n    \"scminput\": false\n  },\n  \"kilo-code.allowedCommands\": [\n    \"git log\",\n    \"git diff\",\n    \"git show\"\n  ],\n  \"kilo-code.deniedCommands\": [],\n  \"codeium.enableConfig\": {\n    \"*\": true,\n    \"markdown\": true\n  },\n  \"claudeCode.preferredLocation\": \"panel\",\n  \"github.copilot.nextEditSuggestions.enabled\": true,\n  \"cSpell.userWords\": [\n    \"orpc\"\n  ],\n  \"editor.gotoLocation.multipleDefinitions\": \"goto\",\n  \"diffEditor.ignoreTrimWhitespace\": false,\n  \"js/ts.updateImportsOnFileMove.enabled\": \"always\",\n  \"js/ts.preferGoToSourceDefinition\": true,\n  \"editor.codeActions.triggerOnFocusChange\": true,\n  \"github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions\": true,\n  \"claudeCode.allowDangerouslySkipPermissions\": true,\n  \"github.copilot.editor.enableCodeActions\": false,\n  \"claudeCode.initialPermissionMode\": \"bypassPermissions\",\n  \"coderabbit.autoReviewMode\": \"disabled\",\n  \"tailwindCSS.classFunctions\": [\n    \"cva\",\n    \"clsx\",\n    \"cn\",\n    \"cx\"\n  ],\n  \"js/ts.preferences.autoImportSpecifierExcludeRegexes\": [\n    \"node_modules\"\n  ],\n  \"codeium.enableCodeLens\": false,\n  \"editor.tokenColorCustomizations\": {\n    \"textMateRules\": []\n  },\n  \"camouflage.selective.enabled\": true,\n  \"camouflage.files.patterns\": [\n    \".env*\",\n    \"*.env\",\n    \"*.sh\",\n    \"*.yaml\",\n    \"*.yml\",\n    \"*.properties\",\n    \"*.ini\",\n    \"*.conf\",\n    \"*.toml\"\n  ],\n  \"camouflage.parsers.enabled\": [\n    \"env\",\n    \"yaml\",\n    \"properties\",\n    \"toml\"\n  ]\n}\n",
  "keybindings": "[\n  {\n    \"key\": \"alt+cmd+z\",\n    \"command\": \"git.revertSelectedRanges\",\n    \"when\": \"isInDiffEditor\"\n  },\n  {\n    \"key\": \"cmd+k cmd+r\",\n    \"command\": \"-git.revertSelectedRanges\",\n    \"when\": \"isInDiffEditor\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"-search.searchEditor.action.deleteFileResults\",\n    \"when\": \"inSearchEditor\"\n  },\n  {\n    \"key\": \"shift+cmd+j\",\n    \"command\": \"-editsHistory.moveCursorToPreviouslyEditedFile\"\n  },\n  {\n    \"key\": \"shift+cmd+k\",\n    \"command\": \"-editsHistory.moveCursorToNextEditedFile\"\n  },\n  {\n    \"key\": \"shift+cmd+u\",\n    \"command\": \"-editsHistory.moveCursorToPreviousEditInSameFile\"\n  },\n  {\n    \"key\": \"cmd+u\",\n    \"command\": \"-editsHistory.createEditAtCursor\"\n  },\n  {\n    \"key\": \"cmd+i\",\n    \"command\": \"-editsHistory.removeEditsFromLine\"\n  },\n  {\n    \"key\": \"shift+cmd+i\",\n    \"command\": \"-editsHistory.moveCursorToNextEditInSameFile\"\n  },\n  {\n    \"key\": \"ctrl+shift+cmd+backspace\",\n    \"command\": \"editsHistory.moveCursorToNextEdit\"\n  },\n  {\n    \"key\": \"cmd+k\",\n    \"command\": \"-editsHistory.moveCursorToNextEdit\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"gotoLastEdit.goBack\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"cmd+-\",\n    \"command\": \"-gotoLastEdit.goBack\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"ctrl+shift+cmd+backspace\",\n    \"command\": \"gotoLastEdit.goForward\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"cmd+=\",\n    \"command\": \"-gotoLastEdit.goForward\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+cmd+backspace\",\n    \"command\": \"-workbench.action.navigateToLastEditLocation\"\n  },\n  {\n    \"key\": \"alt+cmd+left\",\n    \"command\": \"-workbench.action.previousEditor\"\n  },\n  {\n    \"key\": \"alt+cmd+right\",\n    \"command\": \"-workbench.action.nextEditor\"\n  },\n  {\n    \"key\": \"cmd+e\",\n    \"command\": \"-actions.findWithSelection\"\n  },\n  {\n    \"key\": \"shift+alt+o\",\n    \"command\": \"-editor.action.organizeImports\",\n    \"when\": \"editorTextFocus && !editorReadonly && supportedCodeAction =~ /(\\\\s|^)source\\\\.organizeImports\\\\b/\"\n  },\n  {\n    \"key\": \"cmd+e\",\n    \"command\": \"workbench.action.quickOpen\"\n  },\n  {\n    \"key\": \"cmd+up\",\n    \"command\": \"block-travel.jumpUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"alt+up\",\n    \"command\": \"-block-travel.jumpUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"cmd+down\",\n    \"command\": \"block-travel.jumpDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"alt+down\",\n    \"command\": \"-block-travel.jumpDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+cmd+down\",\n    \"command\": \"block-travel.selectDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+alt+down\",\n    \"command\": \"-block-travel.selectDown\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+cmd+up\",\n    \"command\": \"block-travel.selectUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"shift+alt+up\",\n    \"command\": \"-block-travel.selectUp\",\n    \"when\": \"editorTextFocus\"\n  },\n  {\n    \"key\": \"alt+cmd+j\",\n    \"command\": \"-liveshare.join\",\n    \"when\": \"liveshare:state != 'Joined' && liveshare:state != 'Shared'\"\n  },\n  {\n    \"key\": \"alt+cmd+j\",\n    \"command\": \"editor.action.surroundWithSnippet\"\n  },\n  {\n    \"key\": \"cmd+j\",\n    \"command\": \"editor.action.insertSnippet\"\n  },\n  {\n    \"key\": \"cmd+j\",\n    \"command\": \"-workbench.action.togglePanel\"\n  },\n  {\n    \"key\": \"shift+cmd+delete\",\n    \"command\": \"editor.emmet.action.removeTag\"\n  },\n  {\n    \"key\": \"cmd+i\",\n    \"command\": \"composerMode.agent\"\n  },\n  {\n    \"key\": \"ctrl+shift+alt+down\",\n    \"command\": \"editor.action.dirtydiff.next\",\n    \"when\": \"editorTextFocus && !textCompareEditorActive\"\n  },\n  {\n    \"key\": \"alt+f3\",\n    \"command\": \"-editor.action.dirtydiff.next\",\n    \"when\": \"editorTextFocus && !textCompareEditorActive\"\n  },\n  {\n    \"key\": \"ctrl+shift+alt+down\",\n    \"command\": \"notebook.diff.action.next\",\n    \"when\": \"activeEditor == 'workbench.editor.notebookTextDiffEditor'\"\n  },\n  {\n    \"key\": \"alt+f3\",\n    \"command\": \"-notebook.diff.action.next\",\n    \"when\": \"activeEditor == 'workbench.editor.notebookTextDiffEditor'\"\n  },\n  {\n    \"key\": \"ctrl+shift+alt+up\",\n    \"command\": \"editor.action.dirtydiff.previous\",\n    \"when\": \"editorTextFocus && !textCompareEditorActive\"\n  },\n  {\n    \"key\": \"shift+alt+f3\",\n    \"command\": \"-editor.action.dirtydiff.previous\",\n    \"when\": \"editorTextFocus && !textCompareEditorActive\"\n  },\n  {\n    \"key\": \"ctrl+shift+alt+up\",\n    \"command\": \"notebook.diff.action.previous\",\n    \"when\": \"activeEditor == 'workbench.editor.notebookTextDiffEditor'\"\n  },\n  {\n    \"key\": \"shift+alt+f3\",\n    \"command\": \"-notebook.diff.action.previous\",\n    \"when\": \"activeEditor == 'workbench.editor.notebookTextDiffEditor'\"\n  },\n  {\n    \"key\": \"shift+cmd+z\",\n    \"command\": \"-extension.vscode-git-automator.addAndCommitCurrentFile\"\n  },\n  {\n    \"comment\": \"Focus the active editor group when the escape key is pressed and no text editor is focused https://stackoverflow.com/questions/55190841/how-can-i-make-vscode-focus-on-the-active-editor-by-hitting-escape\",\n    \"key\": \"escape\",\n    \"command\": \"workbench.action.focusActiveEditorGroup\",\n    \"when\": \"!editorTextFocus\"\n  },\n  {\n    \"key\": \"f4\",\n    \"command\": \"git.openFile\",\n    \"when\": \"config.git.enabled && isInDiffEditor && !git.missing && gitOpenRepositoryCount != '0' && resourceScheme =~ /^git$|^file$/\"\n  },\n  {\n    \"key\": \"cmd+n\",\n    \"command\": \"-workbench.action.files.newUntitledFile\"\n  },\n  {\n    \"key\": \"cmd+n\",\n    \"command\": \"workbench.files.action.createFileFromExplorer\"\n  },\n  {\n    \"key\": \"shift+cmd+k\",\n    \"command\": \"-editor.action.deleteLines\",\n    \"when\": \"textInputFocus && !editorReadonly\"\n  },\n  {\n    \"key\": \"up\",\n    \"command\": \"list.focusUp\",\n    \"when\": \"!inputFocus && listFocus\"\n  },\n  {\n    \"key\": \"down\",\n    \"command\": \"list.focusDown\",\n    \"when\": \"!inputFocus && listFocus\"\n  },\n  {\n    \"key\": \"home\",\n    \"command\": \"list.focusFirst\",\n    \"when\": \"!inputFocus && listFocus\"\n  },\n  {\n    \"key\": \"end\",\n    \"command\": \"list.focusLast\",\n    \"when\": \"!inputFocus && listFocus\"\n  },\n  {\n    \"key\": \"pageup\",\n    \"command\": \"list.focusPageUp\",\n    \"when\": \"!inputFocus && listFocus\"\n  },\n  {\n    \"key\": \"pagedown\",\n    \"command\": \"list.focusPageDown\",\n    \"when\": \"!inputFocus && listFocus\"\n  },\n  {\n    \"comment\": \"When cmd+shift+f - focus on the result when key down\",\n    \"key\": \"down\",\n    \"command\": \"runCommands\",\n    \"when\": \"searchInputBoxFocus\",\n    \"args\": {\n      \"commands\": [\n        \"search.action.focusSearchList\",\n        \"list.focusDown\"\n      ]\n    }\n  },\n  {\n    \"comment\": \"When in changes view - focus on the results\",\n    \"key\": \"down\",\n    \"command\": \"runCommands\",\n    \"when\": \"focusedView == workbench.scm && inputFocus\",\n    \"args\": {\n      \"commands\": [\n        \"list.focusFirst\",\n        \"list.focusDown\",\n        \"list.focusDown\",\n        \"list.focusDown\"\n      ]\n    }\n  },\n  {\n    \"comment\": \"In Source Control view, discard Git changes for the selected file(s) when the list (not the input) is focused\",\n    \"key\": \"cmd+alt+z\",\n    \"command\": \"git.clean\",\n    \"when\": \"focusedView == workbench.scm && !inputFocus && listFocus\"\n  },\n  {\n    \"key\": \"ctrl+m\",\n    \"command\": \"editor.emmet.action.matchTag\"\n  },\n  {\n    \"key\": \"shift+cmd+c\",\n    \"command\": \"-workbench.action.terminal.openNativeConsole\",\n    \"when\": \"!terminalFocus\"\n  }\n]\n",
  "extensions": "[{\"identifier\": {\"id\": \"aaron-bond.better-comments\"}, \"displayName\": \"aaron-bond.better-comments\"}, {\"identifier\": {\"id\": \"anteprimorac.html-end-tag-labels\"}, \"displayName\": \"anteprimorac.html-end-tag-labels\"}, {\"identifier\": {\"id\": \"antfu.array-index-inlay\"}, \"displayName\": \"antfu.array-index-inlay\"}, {\"identifier\": {\"id\": \"antfu.cpupro\"}, \"displayName\": \"antfu.cpupro\"}, {\"identifier\": {\"id\": \"antfu.goto-alias\"}, \"displayName\": \"antfu.goto-alias\"}, {\"identifier\": {\"id\": \"antfu.json-discovery\"}, \"displayName\": \"antfu.json-discovery\"}, {\"identifier\": {\"id\": \"antfu.open-in-github-button\"}, \"displayName\": \"antfu.open-in-github-button\"}, {\"identifier\": {\"id\": \"antfu.pnpm-catalog-lens\"}, \"displayName\": \"antfu.pnpm-catalog-lens\"}, {\"identifier\": {\"id\": \"antfu.retypewriter\"}, \"displayName\": \"antfu.retypewriter\"}, {\"identifier\": {\"id\": \"antfu.smart-clicks\"}, \"displayName\": \"antfu.smart-clicks\"}, {\"identifier\": {\"id\": \"antfu.vscode-server-controller\"}, \"displayName\": \"antfu.vscode-server-controller\"}, {\"identifier\": {\"id\": \"antfu.where-am-i\"}, \"displayName\": \"antfu.where-am-i\"}, {\"identifier\": {\"id\": \"be5invis.toml\"}, \"displayName\": \"be5invis.toml\"}, {\"identifier\": {\"id\": \"bierner.comment-tagged-templates\"}, \"displayName\": \"bierner.comment-tagged-templates\"}, {\"identifier\": {\"id\": \"bierner.markdown-preview-github-styles\"}, \"displayName\": \"bierner.markdown-preview-github-styles\"}, {\"identifier\": {\"id\": \"bloop.vibe-kanban\"}, \"displayName\": \"bloop.vibe-kanban\"}, {\"identifier\": {\"id\": \"britesnow.vscode-toggle-quotes\"}, \"displayName\": \"britesnow.vscode-toggle-quotes\"}, {\"identifier\": {\"id\": \"chiptus.refactor-jsx\"}, \"displayName\": \"chiptus.refactor-jsx\"}, {\"identifier\": {\"id\": \"christian-kohler.npm-intellisense\"}, \"displayName\": \"christian-kohler.npm-intellisense\"}, {\"identifi