  "snippets": "{\"snippets\": {\"typescriptreact.json\": \"{\\n\\t// Place your snippets for typescriptreact here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"Destructuring\\\": {\\n\\t\\t\\\"prefix\\\": \\\"co\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"const {$2} = ${1|props|};\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Destructuring\\\"\\n\\t},\\n\\t\\\"Suspense\\\": {\\n\\t\\t\\\"prefix\\\": \\\"sus\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"<Suspense fallback={<div>loading...</div>}>$0</Suspense>\\\"\\n\\t\\t]\\n\\t},\\n\\t// \\\"function\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"f\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"function $0() {\\\",\\n\\t// \\t\\t\\\"  \\\",\\n\\t// \\t\\t\\\"}\\\"\\n\\t// \\t]\\n\\t// },\\n\\t\\\"console.log\\\": {\\n\\t\\t\\\"prefix\\\": \\\"clg\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"console.log($0)\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"useEffect\\\": {\\n\\t\\t\\\"prefix\\\": \\\"ue\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"useEffect(() => {\\\",\\n\\t\\t\\t\\\"  ${0}\\\",\\n\\t\\t\\t\\\"}, [])\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"children-prop-types\\\": {\\n\\t\\t\\\"prefix\\\": \\\"cc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"children: ReactNode\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"useState\\\": {\\n\\t\\t\\\"prefix\\\": \\\"rust\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"const [${1}, set${1/(.*)/${1:/capitalize}/}] = useState($0)\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"useState with proper camel casing for setter function name.\\\"\\n\\t},\\n\\t\\\"queryClient\\\": {\\n\\t\\t\\\"prefix\\\": \\\"qc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"const queryClient = useQueryClient()\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Tanstack Query useQueryClient\\\"\\n\\t},\\n\\t\\\"use client\\\": {\\n\\t\\t\\\"prefix\\\": \\\"uc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"\\\\\\\"use client\\\\\\\";\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"React \\\\\\\"use client\\\\\\\"\\\"\\n\\t},\\n\\t\\\"useTranslations\\\": {\\n\\t\\t\\\"prefix\\\": \\\"tt\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"const { t } = useTranslation();\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"i18n useTranslations hook\\\"\\n\\t},\\n\\t\\\"Create component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"crc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"export function ${TM_FILENAME_BASE}() {\\\",\\n\\t\\t\\t\\\"  $1\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create react component\\\"\\n\\t},\\n\\t\\\"Create page component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"cpc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"export default async function $2Page(props: PageProps<$1>) {\\\",\\n\\t\\t\\t\\\" const {params, searchParams} = props;\\\",\\n\\t\\t\\t\\\"  return (\\\",\\n\\t\\t\\t\\\"    <div>Page</div>\\\",\\n\\t\\t\\t\\\"  );\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create page component\\\"\\n\\t},\\n\\t\\\"Create layout component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"clc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"export function $2Layout(props: LayoutProps<$1>) {\\\",\\n\\t\\t\\t\\\"  const { children } = props;\\\",\\n\\t\\t\\t\\\"  return (\\\",\\n\\t\\t\\t\\\"    <div>\\\",\\n\\t\\t\\t\\\"      {children}\\\",\\n\\t\\t\\t\\\"    </div>\\\",\\n\\t\\t\\t\\\"  );\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create layout component\\\"\\n\\t},\\n\\t\\\"Props\\\": {\\n\\t\\t\\\"prefix\\\": \\\"ip\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"interface Props {\\\",\\n\\t\\t\\t\\\"  $1\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create props intetrface\\\"\\n\\t},\\n\\t\\\"Props definitions\\\": {\\n\\t\\t\\\"prefix\\\": \\\"pp\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"props: Props\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create props intetrface\\\"\\n\\t},\\n\\t\\\"Functional component\\\": {\\n\\t\\t\\\"prefix\\\": \\\"fc\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"function $1(props: Props) {\\\",\\n\\t\\t\\t\\\"  const {$2} = props;\\\",\\n\\t\\t\\t\\\"  return ( \\\",\\n\\t\\t\\t\\\"    <div></div>\\\",\\n\\t\\t\\t\\\"  )\\\",\\n\\t\\t\\t\\\"}\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Create props intetrface\\\"\\n\\t},\\n\\t\\\"ReactNode\\\": {\\n\\t\\t\\\"prefix\\\": \\\"RN\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"ReactNode\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"ReactNode\\\"\\n\\t},\\n}\"}}",
  "icon": "robot"
