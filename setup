#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
command_name="${1:-help}"
if (($#)); then shift; fi
case "$command_name" in
  install) exec "$ROOT/bootstrap/new-mac" "$@" ;;
  doctor) exec python3 "$ROOT/bootstrap/doctor.py" "$@" ;;
  desktop) exec python3 "$ROOT/bootstrap/desktop.py" "$@" ;;
  plan|link|restore|status) exec python3 "$ROOT/bootstrap/manage.py" "$command_name" "$@" ;;
  packages) exec "$ROOT/bootstrap/installations" "$@" ;;
  shell) exec "$ROOT/bootstrap/shell" "$@" ;;
  skills) exec "$ROOT/bin/skills-explicit" "$@" ;;
  node) exec "$ROOT/bootstrap/node" "$@" ;;
  claude) exec "$ROOT/bootstrap/claude" "$@" ;;
  vscode) while IFS= read -r extension; do [[ -z "$extension" || "$extension" == \#* ]] || code --install-extension "$extension"; done < "$ROOT/packages/visual-studio-code-extensions.txt" ;;
  defaults) exec python3 "$ROOT/bootstrap/desktop.py" --apply --system-only ;;
  guide) open "$ROOT/guide/index.html" ;;
  check) exec python3 "$ROOT/tests/check.py" ;;
  help|--help|-h) cat <<'HELP'
Dotfiles — Nir's tools, Schnitz's layout
  ./setup install [--dry-run] [--minimal]               Set up a new Mac (extras included)
  ./setup doctor [--report]                            Check restore gaps; optional saved report
  ./setup desktop [--apply]                            Preview/seed portable app settings
  ./setup plan [--profile core|vim|tmux|vscode|npm|all]  Preview links
  ./setup link [--profile ...] [--replace]              Link; back up conflicts with --replace
  ./setup status [--profile ...]                       Show installed links
  ./setup restore PATH                                Restore a link backup (manifest.json)
  ./setup packages [core|daily|extras|work|mas] [--apply]      Check, or install missing packages
  ./setup shell                                       Install missing Oh My Zsh plugins
  ./setup skills [--check] [--project DIR]              Verify and fix skill invocation settings
  ./setup node                                        Install Node LTS and global CLI packages
  ./setup claude                                      Install native Claude Code (latest, auto-updates)
  ./setup vscode                                      Install saved VS Code extensions
  ./setup defaults                                    Apply curated macOS preferences
  ./setup guide                                       Open the local tools/shortcuts guide
  ./setup check                                       Validate without changing this Mac
Default profile is core. No command installs packages or changes macOS implicitly.
HELP
  ;;
  *) echo "Unknown command: $command_name" >&2; exit 2 ;;
esac
