#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
group="${1:-core}"
if (($#)); then shift; fi
case "$group" in
 core) file="$ROOT/Brewfile" ;;
 daily|extras|work|mas) file="$ROOT/packages/Brewfile.$group" ;;
 *) echo 'Choose core, daily, extras, work, or mas.' >&2; exit 2 ;;
esac
(($# <= 1)) || { echo "Too many arguments." >&2; exit 2; }
command -v brew >/dev/null || { echo 'Install Homebrew from https://brew.sh first.' >&2; exit 1; }
case "${1:-}" in
 --apply) exec brew bundle install --no-upgrade --file="$file" ;;
 '') exec brew bundle check --no-upgrade --verbose --file="$file" ;;
 *) echo 'Only --apply is accepted after the package group.' >&2; exit 2 ;;
esac
