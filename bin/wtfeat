#!/bin/bash

set -eou pipefail

NAME="${1:-}"

if [ "$NAME" == "" ]; then
  echo "Name is empty [first arg]" >&2
  exit 1
fi

REPO="$(basename "$(gitroot)")"

NEWPATH="${WORKTREE_ROOT:-$HOME/dev/worktrees}/$NAME/$REPO"
mkdir -p "$(dirname "$NEWPATH")"
git worktree add -b "${GIT_BRANCH_PREFIX:-nirtamir}/$NAME" "$NEWPATH"
echo "$NEWPATH"
