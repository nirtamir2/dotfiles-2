#!/usr/bin/env bash
# Choose outdated formulae to upgrade. Cancelling never upgrades everything.
set -euo pipefail
if ! selection=$(brew outdated --json | jq -r '.formulae[] | [.name, (.installed_versions | join(",")), .current_version] | @tsv' | fzf --multi --header='Select formulae to upgrade (Esc cancels)' "$@"); then
  exit 0
fi
packages=()
while IFS=$'\t' read -r name rest; do
  [[ -z "$name" ]] || packages+=("$name")
done <<< "$selection"
if ((${#packages[@]})); then brew upgrade "${packages[@]}"; fi
